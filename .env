# Web server port
WEB_PORT=3001

# Password for dashboard login
AUTH_PASSWORD=changeme

# Send deletion alerts to your own WhatsApp (true/false)
NOTIFY_WHATSAPP=true

# Path to Chromium binary (for whatsapp-web.js)
CHROMIUM_PATH=/usr/bin/chromium-browser

# Set to 'production' for secure cookies (when behind HTTPS/Caddy)
NODE_ENV=production

# WhatsApp phone number for pairing code linking (with country code, no + or spaces)
# Set this to your number to use pairing code instead of QR scanning
# Example: 966580833985
# WHATSAPP_PHONE=
