# Web server port
WEB_PORT=3001

# Password for dashboard login
AUTH_PASSWORD=your_password

# Optional: Dedicated phone number for Pairing Code (omit for QR mode)
WHATSAPP_PHONE=

# Optional: Receive a WhatsApp alert whenever a message is deleted (true/false)
NOTIFY_WHATSAPP=false

# Optional: Pairing method ('code' or 'qr'). Default is 'code' if WHATSAPP_PHONE is set.
WHATSAPP_PAIRING_METHOD=code

# Set to 'production' for secure/https-only cookies
NODE_ENV=production

# Set to 'true' if running behind a reverse proxy (Caddy/Nginx)
TRUST_PROXY=true

# Optional: Custom storage paths
# DATA_DIR=./data
# MEDIA_DIR=./data/media
# DB_PATH=./data/messages.db
